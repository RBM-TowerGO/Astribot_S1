<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!-- Static recorded map: retain a feasible path through final rotation.
         Replan after a stopped controller failure, rather than replacing the
         terminal maneuver repeatedly as localization changes. -->
    <RecoveryNode number_of_retries="3" name="ReplanWhenBlocked">
      <Sequence>
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
        <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="goal_checker"/>
      </Sequence>
      <Wait wait_duration="0.5"/>
    </RecoveryNode>
  </BehaviorTree>
</root>
