<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!-- Keep following the current valid path while the next plan is computed.
         A planning/control failure still terminates safely; no blind Wait loop. -->
    <PipelineSequence name="NavigateWithConcurrentReplanning">
      <RateController hz="1.0">
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
      </RateController>
      <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="goal_checker"/>
    </PipelineSequence>
  </BehaviorTree>
</root>
